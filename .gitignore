# Frontend (Vercel) generated files.
#
# Paths here are relative to `frontend/`, which is what makes them survive a
# directory reorganisation — the previous root-level `public/assets/...` patterns
# silently stopped matching when this application moved, and the excluded video
# files became committable.

node_modules
dist
dist-ssr
*.local

# The admin is a separate npm project nested here, with its own dependency tree.
admin/node_modules
admin/dist

# Environment. Only the template is tracked.
.env
.env.*
!.env.example

# Large binary media.
#
# These rules originally excluded ALL video, on the assumption that the build
# directory would be uploaded to a host separately. That assumption no longer
# holds: Vercel builds from this repository and ships only what git contains, so
# an excluded asset is a 404 in production — the hero video simply would not
# exist, and the site would fall back to the poster on every device.
#
# The one video the site actually uses is therefore committed. At 876 KB that is
# an unremarkable thing to keep in git, and far simpler than Git LFS or
# out-of-band hosting for a single file that never changes.
public/assets/background/*.webm
public/assets/audio/*.mp3
public/assets/audio/*.m4a
# The clip the site uses, and the stand-in audio, so a fresh clone runs as-is.
!public/assets/background/cabin-background.mp4
!public/assets/audio/placeholder-ambient.mp3
# The unused alternative clip stays out; see public/assets/background/README.md.
public/assets/background/cabin-background-alt.mp4
